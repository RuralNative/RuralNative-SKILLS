# The repo is the distribution source, never its own consumer.
# Local `npx skills add` artifacts would duplicate skills/ and drift.
.agents/
skills-lock.json

# Kilo worktrees hold untracked agent checkouts with stale copies of
# docs/ that mislead grep-based navigation and stay invisible to git
# and the docs harness, so the directory stays ignored.
.kilo/worktrees/

# Dependency installs stay local; only package.json and the lockfile are canonical.
node_modules/
